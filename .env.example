# Copy to .env and adjust. Every value has a safe default for local use
# except DJANGO_SECRET_KEY, which MUST be set for any real deployment.
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
WEB_CONCURRENCY=2
